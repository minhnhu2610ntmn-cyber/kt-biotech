{
  "name": "ktbiotech",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "app/packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "yarn workspace @ktbiotech/system-design build && yarn workspace @ktbiotech/blog build && next build --turbopack",
    "start": "next start",
    "lint": "eslint app/packages/system-design/src/ --ext .ts,.tsx",
    "lint:fix": "eslint app/packages/system-design/src/ --ext .ts,.tsx --fix",
    "lint:check": "eslint app/packages/system-design/src/ --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write app/packages/system-design/src/**/*.{ts,tsx,js,jsx,json,css,md}",
    "format:check": "prettier --check app/packages/system-design/src/**/*.{ts,tsx,js,jsx,json,css,md}",
    "check": "npm run lint:check && npm run format:check",
    "fix": "npm run lint:fix && npm run format",
    "commit": "cz",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:system-design": "yarn workspace @ktbiotech/system-design build:clean",
    "build:blog": "yarn workspace @ktbiotech/blog build:clean",
    "prepare": "husky"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/react-select": "^5.0.0",
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "next": "16.0.8",
    "next-intl": "4.5.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.65.0",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@chromatic-com/storybook": "^4.1.1",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/eslintrc": "^3",
    "@storybook/addon-a11y": "^9.1.10",
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/addon-links": "^9.1.10",
    "@storybook/addon-onboarding": "^9.1.10",
    "@storybook/addon-vitest": "^9.1.10",
    "@storybook/nextjs": "^9.1.10",
    "@storybook/nextjs-vite": "^9.1.10",
    "@storybook/react-webpack5": "^9.1.10",
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9",
    "eslint-plugin-storybook": "^9.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "playwright": "^1.56.0",
    "storybook": "^9.1.10",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "app/packages/system-design/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "app/packages/system-design/src/**/*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
