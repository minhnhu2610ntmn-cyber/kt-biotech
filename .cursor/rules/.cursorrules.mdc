### **Form Pattern**

```tsx
import { Form, Input, Select, Button } from '@ktbiotech/system-design';

export default function ContactForm() {
  return (
    <Form onSubmit={handleSubmit}>
      <div className='space-y-6'>
        <Input placeholder='Name' />
        <Input type='email' placeholder='Email' />
        <Select options={countryOptions} placeholder='Country' />
        <Button type='submit'>Submit</Button>
      </div>
    </Form>
  );
}
```

### **Data Display Pattern**

```tsx
import { Table } from '@ktbiotech/system-design';

export default function DataTable() {
  return (
    <Table
      columns={columns}
      dataSource={data}
      pagination={{ pageSize: 10 }}
      selectable={true}
      onRowClick={handleRowClick}
    />
  );
}
```

### **Slider Pattern**

```tsx
import { Slider, SliderPresets } from '@ktbiotech/system-design';

export default function HeroSlider() {
  return (
    <Slider {...SliderPresets.hero}>
      <div>Slide 1</div>
      <div>Slide 2</div>
      <div>Slide 3</div>
    </Slider>
  );
}

export default function ProductCarousel() {
  return (
    <Slider {...SliderPresets.productCarousel}>
      {products.map(product => (
        <ProductCard key={product.id} product={product} />
      ))}
    </Slider>
  );
}
```

### **Step Pattern**

```tsx
import { Step, StepPresets } from '@ktbiotech/system-design';

export default function OnboardingSteps() {
  const steps = [
    { title: 'Welcome', description: 'Get started' },
    { title: 'Setup', description: 'Configure your account' },
    { title: 'Complete', description: "You're all set!" },
  ];

  return <Step items={steps} {...StepPresets.onboarding} />;
}
```

### **Navbar Pattern**

```tsx
import { MasterLayout } from '../components/layout';
import { useNavbarConfig } from '../hooks';

export default function Page() {
